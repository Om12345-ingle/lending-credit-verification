pragma language_version >= 0.22;

import CompactStandardLibrary;

export ledger min_credit_score: Uint<32>;
export ledger issued_credentials: Map<Bytes<32>, Boolean>;
export ledger admin: Bytes<32>;

constructor(min_score: Uint<32>, admin_pk: Bytes<32>) {
  min_credit_score = disclose(min_score);
  admin = disclose(admin_pk);
}

witness localSecretKey(): Bytes<32>;
witness creditScore(): Uint<32>;
witness credentialSalt(): Bytes<32>;

export circuit issueCredential(commitment: Bytes<32>): [] {
  assert(disclose(publicKey(localSecretKey())) == admin, "Only admin can issue credit credentials");
  issued_credentials.insert(disclose(commitment), true);
}

export circuit verifyCredit(): Boolean {
  const commitment = credentialCommitment(creditScore(), credentialSalt());
  assert(issued_credentials.member(disclose(commitment)), "Credit credential was not issued by the administrator");
  assert(creditScore() >= min_credit_score, "Credit score is below requirement");
  
  return disclose(true);
}

export circuit credentialCommitment(score: Uint<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "credit:credential:"),
    score as Field as Bytes<32>,
    salt
  ]);
}

export circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "credit:pk:"), sk]);
}
